# Base URL of the future REST API (e.g. Laravel). Not used yet — the demo
# 1:1 flow (/, /partidas, /mis-apuestas, /historial) runs entirely on
# mocked data (src/data) persisted to localStorage. See README "Conectar
# una API REST" for that migration path.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Motor de emparejamiento real (Supabase/Postgres) — usado por /exchange/*
# y src/actions/betting.ts. Ver README "Motor de emparejamiento" para el
# paso a paso de configuración y aplicación de supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Secreta — solo servidor. Nunca exponer al cliente ni commitear.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
