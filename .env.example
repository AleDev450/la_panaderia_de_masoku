# Supabase — todo el estado de la app vive acá (cuentas, apuestas,
# recargas). Ver README "Configuración" para el paso a paso y el orden de
# las migraciones en supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Secreta — solo servidor. Salta RLS por completo: con esta clave se puede
# leer y escribir cualquier fila de cualquier tabla. Nunca la expongas al
# cliente (no le pongas el prefijo NEXT_PUBLIC_) ni la commitees.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
